FROM mcr.microsoft.com/devcontainers/universal:2
USER root

# Instalar dependências para QEMU e interface gráfica
RUN apt-get update && apt-get install -y \
    qemu-kvm \
    libvirt-daemon-system \
    libvirt-clients \
    bridge-utils \
    virt-manager \
    novnc \
    websockify \
    fluxbox \
    x11vnc \
    xvfb

# Configurar permissões para KVM
RUN adduser vscode kvm
